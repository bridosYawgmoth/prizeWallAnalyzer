{
    "name": "bridos/prize-wall-analyzer",
    "description": "MTG prize wall analyzer API",
    "type": "project",
    "require": {
        "php": "^8.2",
        "symfony/flex": "^2.11",
        "symfony/runtime": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/http-client": "^7.4"
    },
    "authors": [
        {
            "name": "Konstantinos Giavridis",
            "email": "constantine_giavridis@hotmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
